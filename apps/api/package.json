{
  "name": "@nova/api",
  "version": "0.1.0",
  "private": true,
  "description": "NOVA REST API (NestJS), served by the web app at /api or standalone",
  "scripts": {
    "build": "nest build",
    "dev": "nest build --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "nest build && vitest run"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/platform-express": "11.2.11",
    "@nestjs/throttler": "6.8.0",
    "@nova/db": "workspace:*",
    "@nova/shared": "workspace:*",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7",
    "@anthropic-ai/sdk": "1.12.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.11",
    "@nova/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.15.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "main": "./dist/main.js",
  "exports": {
    "./serverless": "./dist/serverless.js",
    "./package.json": "./package.json"
  }
}
