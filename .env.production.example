# Production environment for the Vercel project (Settings → Environment Variables → Production).
# Do NOT commit real values. Enter each variable in the Vercel dashboard, or with the CLI:
#   vercel env add DATABASE_URL production
# Vercel sets NODE_ENV=production and VERCEL_* itself; the API trusts the deployment's own
# *.vercel.app hostnames automatically, so WEB_ORIGIN only needs your custom domain(s).

# ─── Database (required) ─────────────────────────────────────────────────────
# Dedicated Atlas database user with readWrite on the production database only.
# Network Access: allow 0.0.0.0/0 (Vercel has no fixed egress IPs) or use Vercel's Atlas integration.
# Put the cluster in AWS Mumbai (ap-south-1) to sit next to the bom1 function region.
DATABASE_URL=mongodb+srv://nova_prod:<strong-password>@<cluster>.mongodb.net/nova?retryWrites=true&w=majority&appName=nova-studio

# ─── App (required) ──────────────────────────────────────────────────────────
# Public HTTPS origin(s) of the Studio, comma-separated. http:// is refused in production
# except for localhost.
WEB_ORIGIN=https://studio.example.com
# Absolute session lifetime and idle timeout.
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=8

# ─── NOVA AI (optional) ──────────────────────────────────────────────────────
# Without a key the assistant runs in demo mode. Use a production key with a spend limit.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# ─── One-off: first seed of an empty production database ────────────────────
# Not needed on Vercel. Run once from your machine with the production DATABASE_URL in your shell:
#   pnpm db:setup && pnpm db:seed
# WARNING: db:seed WIPES the database and loads demo data. Never run it against live data.
# With NODE_ENV=production it also needs SEED_CONFIRM_WIPE=yes.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Studio Admin

# ─── Client communication (optional) ─────────────────────────────────────────
# Without these, client messages the studio approves are recorded as SIMULATED: nothing is sent.
# With both set, approved email messages go out through Resend (https://resend.com).
# WhatsApp has no integration and is always simulated.
# RESEND_API_KEY=
# MAIL_FROM=Studio <studio@your-domain.example>
# Name used for {{studio}} in message templates (default: Neon Minds).
# STUDIO_NAME=Neon Minds
# Base URL for {{reviewLink}} (the deliverable id is appended). Without it, review messages are
# held as drafts until someone pastes the link.
# REVIEW_LINK_BASE=https://review.your-domain.example/d
