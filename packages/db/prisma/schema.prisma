// NOVA — data model. See docs/architecture/02-domain-model.md.
// Enum values mirror packages/shared/src/constants/enums.ts.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity & access ────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  avatarUrl    String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions           Session[]
  teamMember         TeamMember?
  activities         ActivityLog[]
  notifications      Notification[]
  assistantMessages  AssistantInteraction[]
  stageTransitions   StageTransition[]
  interactionsLogged ClientInteraction[]
  notificationPrefs  NotificationPreference[]
  approvalsRequested ApprovalRequest[]        @relation("ApprovalRequester")
  approvalDecisions  ApprovalStep[]           @relation("ApprovalDecider")
  expensesSubmitted  Expense[]                @relation("ExpenseSubmitter")
  invoicesCreated    Invoice[]                @relation("InvoiceCreator")
  paymentsRecorded   Payment[]                @relation("PaymentRecorder")
  purchaseRequests   PurchaseRequest[]        @relation("PurchaseRequester")
  purchaseOrders     PurchaseOrder[]          @relation("PurchaseOrderCreator")
  stockMovements     StockMovement[]
  studioBookings     StudioBooking[]
  documentsCreated   Document[]               @relation("DocumentCreator")
  documentVersions   DocumentVersion[]
  leadsOwned         Lead[]                   @relation("LeadOwner")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Role {
  id          String           @id @default(cuid())
  /// Free-form key (ADR-0009). SUPER_ADMIN is system-locked.
  key         String           @unique
  name        String
  description String?
  /// System roles cannot be deleted; SUPER_ADMIN's permissions cannot be edited.
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// ─── People ───────────────────────────────────────────────────────────────────

enum StudioLocation {
  KOZHIKODE
  CHENNAI
}

model TeamMember {
  id                  String         @id @default(cuid())
  name                String
  title               String
  skills              String[]
  baseLocation        StudioLocation
  weeklyCapacityHours Int            @default(40)
  avatarUrl           String?
  email               String?
  isActive            Boolean        @default(true)
  userId              String?        @unique
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId        String?
  department          Department?    @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  employmentType      EmploymentType @default(FULL_TIME)
  joinedOn            DateTime?
  createdAt           DateTime       @default(now())

  tasks           Task[]
  projectRoles    ProjectMember[]
  crewCalls       CrewCall[]
  stagesOwned     ProjectStage[]
  record          EmployeeRecord?
  leaveRequests   LeaveRequest[]
  attendance      AttendanceRecord[]
  departmentsLed  Department[]       @relation("DepartmentLead")
  assetsInCustody Asset[]            @relation("AssetCustodian")
  risksOwned      ProjectRisk[]
  documents       Document[]
}

model ProjectMember {
  projectId    String
  teamMemberId String
  role         String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@id([projectId, teamMemberId])
}

// ─── Clients & sales ──────────────────────────────────────────────────────────

enum ClientStatus {
  LEAD
  ACTIVE
  DORMANT
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  FEEDBACK
}

model Client {
  id           String       @id @default(cuid())
  name         String
  industry     String
  city         String
  status       ClientStatus @default(ACTIVE)
  contactName  String?
  contactEmail String?
  contactPhone String?
  accentColor  String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  projects     Project[]
  interactions ClientInteraction[]
  leads        Lead[]
  contacts     ClientContact[]
  invoices     Invoice[]
  documents    Document[]
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ClientInteraction {
  id         String          @id @default(cuid())
  clientId   String
  client     Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type       InteractionType
  summary    String
  occurredAt DateTime
  loggedById String?
  loggedBy   User?           @relation(fields: [loggedById], references: [id], onDelete: SetNull)
  createdAt  DateTime        @default(now())

  @@index([clientId, occurredAt])
}

enum LeadStage {
  INQUIRY
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  REFERRAL
  INSTAGRAM
  LINKEDIN
}

model Lead {
  id                 String      @id @default(cuid())
  title              String
  clientId           String?
  client             Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  prospectName       String?
  projectType        ProjectType
  estimatedValue     Int
  stage              LeadStage   @default(INQUIRY)
  source             LeadSource
  expectedCloseDate  DateTime?
  notes              String?
  convertedProjectId String?     @unique
  convertedProject   Project?    @relation(fields: [convertedProjectId], references: [id], onDelete: SetNull)
  ownerId            String?
  owner              User?       @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  nextFollowUpAt     DateTime?
  lostReason         String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  documents          Document[]

  @@index([stage])
  @@index([nextFollowUpAt])
}

// ─── Workflow definitions ─────────────────────────────────────────────────────

enum StageKey {
  BRIEF
  PRE_PRODUCTION
  SHOOT
  EDIT
  REVIEW
  DELIVERY
}

model WorkflowTemplate {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  isDefault   Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  stages      StageDefinition[]
  projects    Project[]
}

model StageDefinition {
  id               String           @id @default(cuid())
  templateId       String
  template         WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key              StageKey
  label            String
  order            Int
  expectedDays     Int
  requiresApproval Boolean          @default(false)
  skippable        Boolean          @default(false)
  exitCriteria     String[]
  projectStages    ProjectStage[]

  @@unique([templateId, key])
  @@unique([templateId, order])
}

// ─── Projects ─────────────────────────────────────────────────────────────────

enum ProjectType {
  PRODUCT_VIDEO
  BRAND_FILM
  STORYTELLING_AD
  CORPORATE_VIDEO
  SOCIAL_REEL
  PRODUCT_DEMO
  EXPLAINER
  EVENT_COVERAGE
  AERIAL
  MOTION_GRAPHICS
  REAL_ESTATE
  CAMPAIGN
  STUDIO_GREEN_SCREEN
  PODCAST
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Project {
  id                 String           @id @default(cuid())
  code               String           @unique
  title              String
  logline            String?
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id])
  type               ProjectType
  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])
  status             ProjectStatus    @default(ACTIVE)
  priority           Priority         @default(MEDIUM)
  location           StudioLocation
  startDate          DateTime
  dueDate            DateTime
  deliveredAt        DateTime?
  budget             Int
  includedRevisions  Int              @default(2)
  coverImageUrl      String?
  aiAssisted         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  stages           ProjectStage[]
  transitions      StageTransition[]
  tasks            Task[]
  members          ProjectMember[]
  deliverables     Deliverable[]
  shoots           Shoot[]
  finances         FinancialRecord[]
  interactions     ClientInteraction[]
  bookings         AssetBooking[]
  lead             Lead?
  milestones       Milestone[]
  risks            ProjectRisk[]
  expenses         Expense[]
  invoices         Invoice[]
  purchaseRequests PurchaseRequest[]
  stockMovements   StockMovement[]
  studioBookings   StudioBooking[]
  documents        Document[]
  approvalRequests ApprovalRequest[]

  @@index([status, dueDate])
  @@index([clientId])
}

enum StageStatus {
  PENDING
  ACTIVE
  BLOCKED
  DONE
  SKIPPED
}

model ProjectStage {
  id                String          @id @default(cuid())
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stageDefinitionId String
  stageDefinition   StageDefinition @relation(fields: [stageDefinitionId], references: [id])
  status            StageStatus     @default(PENDING)
  ownerId           String?
  owner             TeamMember?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  startedAt         DateTime?
  completedAt       DateTime?

  tasks           Task[]
  approvals       Approval[]
  transitionsFrom StageTransition[] @relation("TransitionFrom")
  transitionsTo   StageTransition[] @relation("TransitionTo")

  @@unique([projectId, stageDefinitionId])
  @@index([status])
}

enum TransitionDirection {
  FORWARD
  BACKWARD
}

enum ActivitySource {
  UI
  ASSISTANT
  SYSTEM
}

model StageTransition {
  id          String              @id @default(cuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStageId String?
  fromStage   ProjectStage?       @relation("TransitionFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId   String?
  toStage     ProjectStage?       @relation("TransitionTo", fields: [toStageId], references: [id], onDelete: SetNull)
  direction   TransitionDirection
  reason      String?
  actorId     String?
  actor       User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)
  source      ActivitySource      @default(UI)
  createdAt   DateTime            @default(now())

  @@index([projectId, createdAt])
}

// ─── Tasks ────────────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
}

model Task {
  id              String        @id @default(cuid())
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectStageId  String?
  projectStage    ProjectStage? @relation(fields: [projectStageId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  assigneeId      String?
  assignee        TeamMember?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  status          TaskStatus    @default(TODO)
  priority        Priority      @default(MEDIUM)
  dueDate         DateTime?
  estimateHours   Int?
  isStageBlocking Boolean       @default(false)
  blockedReason   String?
  completedAt     DateTime?
  /// Subtasks point at their parent task (one level deep, enforced by the API).
  parentId        String?
  parent          Task?         @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]        @relation("Subtasks")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  dependsOn  TaskDependency[] @relation("TaskDependsOn")
  dependents TaskDependency[] @relation("TaskDependents")

  @@index([projectId, status])
  @@index([assigneeId, status])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task     @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   Task     @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([taskId, dependsOnId])
}

// ─── Deliverables & approvals ─────────────────────────────────────────────────

enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  DELIVERED
}

model Deliverable {
  id              String            @id @default(cuid())
  projectId       String
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  format          String
  aspectRatio     String
  durationSec     Int?
  status          DeliverableStatus @default(PLANNED)
  currentVersion  Int               @default(0)
  dueDate         DateTime?
  previewImageUrl String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  rounds    RevisionRound[]
  approvals Approval[]

  @@index([projectId, status])
}

model RevisionRound {
  id              String         @id @default(cuid())
  deliverableId   String
  deliverable     Deliverable    @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  number          Int
  sentAt          DateTime
  closedAt        DateTime?
  includedInScope Boolean        @default(true)
  feedback        FeedbackItem[]

  @@unique([deliverableId, number])
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

model FeedbackItem {
  id              String         @id @default(cuid())
  revisionRoundId String
  revisionRound   RevisionRound  @relation(fields: [revisionRoundId], references: [id], onDelete: Cascade)
  timecode        String?
  body            String
  author          String
  status          FeedbackStatus @default(OPEN)
  createdAt       DateTime       @default(now())
}

enum ApprovalKind {
  INTERNAL
  CLIENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model Approval {
  id             String         @id @default(cuid())
  kind           ApprovalKind
  status         ApprovalStatus @default(PENDING)
  deliverableId  String?
  deliverable    Deliverable?   @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  projectStageId String?
  projectStage   ProjectStage?  @relation(fields: [projectStageId], references: [id], onDelete: Cascade)
  title          String
  requestedAt    DateTime       @default(now())
  decidedAt      DateTime?
  decidedBy      String?
  note           String?

  @@index([status, requestedAt])
}

// ─── Shoots & resources ───────────────────────────────────────────────────────

enum ShootStatus {
  PLANNED
  CONFIRMED
  WRAPPED
  CANCELLED
}

model Shoot {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  location  String
  city      StudioLocation
  startsAt  DateTime
  endsAt    DateTime
  callTime  String?
  status    ShootStatus    @default(PLANNED)
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  crew           CrewCall[]
  bookings       AssetBooking[]
  studioBookings StudioBooking[]

  @@index([startsAt])
}

model CrewCall {
  id           String     @id @default(cuid())
  shootId      String
  shoot        Shoot      @relation(fields: [shootId], references: [id], onDelete: Cascade)
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  role         String

  @@unique([shootId, teamMemberId])
}

enum AssetCategory {
  CAMERA
  LENS
  LIGHTING
  AUDIO
  GRIP
  DRONE
  STORAGE
  COMPUTE
}

enum AssetStatus {
  AVAILABLE
  MAINTENANCE
  RETIRED
}

model Asset {
  id           String             @id @default(cuid())
  name         String
  category     AssetCategory
  serialTag    String             @unique
  homeLocation StudioLocation
  status       AssetStatus        @default(AVAILABLE)
  dailyRate    Int
  notes        String?
  condition    AssetCondition     @default(GOOD)
  purchasedOn  DateTime?
  purchaseCost Int?
  custodianId  String?
  custodian    TeamMember?        @relation("AssetCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  bookings     AssetBooking[]
  maintenance  AssetMaintenance[]
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_REPAIR
}

enum MaintenanceKind {
  SERVICE
  REPAIR
  INSPECTION
  CALIBRATION
}

model AssetMaintenance {
  id          String          @id @default(cuid())
  assetId     String
  asset       Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  kind        MaintenanceKind
  description String
  /// Whole rupees.
  cost        Int?
  vendorId    String?
  vendor      Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  startedOn   DateTime
  completedOn DateTime?
  createdAt   DateTime        @default(now())

  @@index([assetId, startedOn])
}

model AssetBooking {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  shootId   String?
  shoot     Shoot?   @relation(fields: [shootId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime @default(now())

  @@index([assetId, startsAt])
}

// ─── Finance (demonstration data) ─────────────────────────────────────────────

enum FinanceKind {
  INCOME
  EXPENSE
}

enum FinanceCategory {
  ADVANCE
  MILESTONE
  FINAL_PAYMENT
  CREW
  EQUIPMENT_RENTAL
  LOCATION
  TRAVEL
  SOFTWARE
  MARKETING
  OVERHEAD
  CONSUMABLES
  POST_PRODUCTION
  MAINTENANCE
}

model FinancialRecord {
  id         String          @id @default(cuid())
  projectId  String?
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  kind       FinanceKind
  category   FinanceCategory
  /// Amount in whole Indian rupees.
  amount     Int
  occurredOn DateTime
  note       String?
  isDemo     Boolean         @default(true)
  /// Set when the entry was posted by a recorded payment (ADR-0011).
  paymentId  String?         @unique
  payment    Payment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  /// Set when the entry was posted by a paid expense (ADR-0011).
  expenseId  String?         @unique
  expense    Expense?        @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  createdAt  DateTime        @default(now())

  @@index([occurredOn])
  @@index([projectId])
}

// ─── System ───────────────────────────────────────────────────────────────────

model ActivityLog {
  id         String         @id @default(cuid())
  actorId    String?
  actor      User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  source     ActivitySource @default(UI)
  action     String
  entityType String
  entityId   String
  /// Project the entity belongs to, for project-scoped history.
  projectId  String?
  summary    String
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([projectId, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
}

enum AssistantRole {
  USER
  ASSISTANT
}

enum AssistantActionStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
  FAILED
  STALE
}

model AssistantInteraction {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           AssistantRole
  content        String
  focusContext   Json?
  references     Json?
  provider       String
  /// BCP-47 language of the message (e.g. "ml", "hi", "en"); null when unknown.
  language       String?
  /// "model" when the AI provider declared the language, "detected" when inferred from text.
  languageSource String?
  createdAt      DateTime          @default(now())
  actions        AssistantAction[]

  @@index([userId, createdAt])
}

model AssistantAction {
  id             String                @id @default(cuid())
  interactionId  String
  interaction    AssistantInteraction  @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  kind           String
  payload        Json
  preview        Json
  /// Snapshot of the target's updatedAt when proposed; used to detect stale proposals.
  targetVersion  String?
  status         AssistantActionStatus @default(PROPOSED)
  error          String?
  resultEntityId String?
  resolvedAt     DateTime?
  createdAt      DateTime              @default(now())
}

// ════════════════════════════════════════════════════════════════════════════
// ERP expansion (Phases 9–13). See docs/development/erp-expansion-plan.md.
// ════════════════════════════════════════════════════════════════════════════

model NotificationPreference {
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Notification category (see NOTIFICATION_CATEGORIES in @nova/shared).
  kind   String
  inApp  Boolean @default(true)

  @@id([userId, kind])
}

// ─── Projects: milestones & risks ─────────────────────────────────────────────

model Milestone {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  dueDate       DateTime
  completedAt   DateTime?
  /// Amount billable when the milestone is reached (whole rupees).
  billingAmount Int?
  createdAt     DateTime  @default(now())
  invoices      Invoice[]

  @@index([projectId, dueDate])
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

model ProjectRisk {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  likelihood RiskLevel
  impact     RiskLevel
  mitigation String?
  status     RiskStatus  @default(OPEN)
  ownerId    String?
  owner      TeamMember? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([projectId, status])
}

// ─── HR ───────────────────────────────────────────────────────────────────────

enum EmploymentType {
  FULL_TIME
  PART_TIME
  FREELANCE
  INTERN
}

model Department {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  leadId      String?
  lead        TeamMember?  @relation("DepartmentLead", fields: [leadId], references: [id], onDelete: SetNull)
  members     TeamMember[] @relation("DepartmentMembers")
  createdAt   DateTime     @default(now())
}

/// Restricted HR details. Readable only with `hr:read`. No salary or bank data is stored.
model EmployeeRecord {
  teamMemberId     String     @id
  teamMember       TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  employeeCode     String     @unique
  phone            String?
  emergencyContact String?
  address          String?
  notes            String?
  updatedAt        DateTime   @updatedAt
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  UNPAID
  COMP_OFF
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id               String            @id @default(cuid())
  teamMemberId     String
  teamMember       TeamMember        @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  type             LeaveType
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  reason           String?
  status           LeaveStatus       @default(PENDING)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  approvalRequests ApprovalRequest[]

  @@index([teamMemberId, startDate])
  @@index([status])
}

enum AttendanceStatus {
  PRESENT
  REMOTE
  ON_SHOOT
  HALF_DAY
  ABSENT
  ON_LEAVE
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  teamMemberId String
  teamMember   TeamMember       @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus
  checkIn      DateTime?
  checkOut     DateTime?
  note         String?
  createdAt    DateTime         @default(now())

  @@unique([teamMemberId, date])
  @@index([date])
}

// ─── Vendors ──────────────────────────────────────────────────────────────────

enum VendorCategory {
  EQUIPMENT_RENTAL
  FREELANCE_CREW
  LOCATION
  CATERING
  TRANSPORT
  POST_PRODUCTION
  SOFTWARE
  SUPPLIES
  OTHER
}

model Vendor {
  id          String         @id @default(cuid())
  name        String         @unique
  category    VendorCategory
  contactName String?
  email       String?
  phone       String?
  city        String?
  notes       String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  expenses       Expense[]
  quotes         VendorQuote[]
  purchaseOrders PurchaseOrder[]
  maintenance    AssetMaintenance[]
  documents      Document[]
}

// ─── Approval engine (ADR-0010) ───────────────────────────────────────────────

enum ApprovalSubject {
  EXPENSE
  PURCHASE_REQUEST
  LEAVE
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model ApprovalRule {
  id         String          @id @default(cuid())
  subject    ApprovalSubject
  name       String
  /// The rule applies when the subject amount is at least this (whole rupees; 0 = always).
  minAmount  Int             @default(0)
  stepOrder  Int
  /// Permission the approver must hold, e.g. "expense:approve".
  permission String
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())

  @@index([subject, isActive])
}

/// Exactly one subject foreign key is set (CHECK constraint in the migration).
model ApprovalRequest {
  id                String                @id @default(cuid())
  subject           ApprovalSubject
  status            ApprovalRequestStatus @default(PENDING)
  title             String
  amount            Int?
  currentStep       Int                   @default(1)
  requestedById     String
  requestedBy       User                  @relation("ApprovalRequester", fields: [requestedById], references: [id])
  projectId         String?
  project           Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  expenseId         String?
  expense           Expense?              @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest?      @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  leaveRequestId    String?
  leaveRequest      LeaveRequest?         @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  decidedAt         DateTime?
  steps             ApprovalStep[]

  @@index([status, subject])
  @@index([expenseId])
  @@index([purchaseRequestId])
  @@index([leaveRequestId])
}

model ApprovalStep {
  id         String             @id @default(cuid())
  requestId  String
  request    ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  permission String
  status     ApprovalStepStatus @default(WAITING)
  deciderId  String?
  decider    User?              @relation("ApprovalDecider", fields: [deciderId], references: [id], onDelete: SetNull)
  reason     String?
  decidedAt  DateTime?

  @@unique([requestId, order])
  @@index([status, permission])
}

// ─── Finance: expenses, invoices, payments (ADR-0011) ─────────────────────────

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id              String            @id @default(cuid())
  number          String            @unique
  title           String
  category        FinanceCategory
  /// Whole rupees.
  amount          Int
  incurredOn      DateTime
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  purchaseOrderId String?           @unique
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  submittedById   String
  submittedBy     User              @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  status          ExpenseStatus     @default(DRAFT)
  notes           String?
  paidAt          DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  ledger          FinancialRecord?
  approvals       ApprovalRequest[]
  documents       Document[]

  @@index([status])
  @@index([projectId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id          String        @id @default(cuid())
  number      String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone?    @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime
  dueDate     DateTime
  /// Whole percent applied to the subtotal. A plain calculation, not tax compliance.
  taxPercent  Int           @default(0)
  subtotal    Int
  tax         Int
  total       Int
  notes       String?
  sentAt      DateTime?
  createdById String
  createdBy   User          @relation("InvoiceCreator", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lines       InvoiceLine[]
  payments    Payment[]
  documents   Document[]

  @@index([status, dueDate])
  @@index([clientId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order       Int
  description String
  quantity    Int
  unitPrice   Int
  amount      Int

  @@unique([invoiceId, order])
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  CASH
}

model Payment {
  id           String           @id @default(cuid())
  invoiceId    String
  invoice      Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount       Int
  receivedOn   DateTime
  method       PaymentMethod
  reference    String?
  recordedById String
  recordedBy   User             @relation("PaymentRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  ledger       FinancialRecord?

  @@index([invoiceId])
}

// ─── Procurement ──────────────────────────────────────────────────────────────

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

model PurchaseRequest {
  id             String                @id @default(cuid())
  number         String                @unique
  title          String
  justification  String?
  projectId      String?
  project        Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedById  String
  requestedBy    User                  @relation("PurchaseRequester", fields: [requestedById], references: [id])
  neededBy       DateTime?
  status         PurchaseRequestStatus @default(DRAFT)
  estimatedTotal Int
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  items          PurchaseRequestItem[]
  quotes         VendorQuote[]
  order          PurchaseOrder?
  approvals      ApprovalRequest[]

  @@index([status])
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  requestId         String
  request           PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  description       String
  quantity          Int
  estimatedUnitCost Int
  stockItemId       String?
  stockItem         StockItem?      @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
}

model VendorQuote {
  id         String          @id @default(cuid())
  requestId  String
  request    PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor          @relation(fields: [vendorId], references: [id])
  amount     Int
  validUntil DateTime?
  notes      String?
  isSelected Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@unique([requestId, vendorId])
}

enum PurchaseOrderStatus {
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  requestId   String?             @unique
  request     PurchaseRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)
  vendorId    String
  vendor      Vendor              @relation(fields: [vendorId], references: [id])
  status      PurchaseOrderStatus @default(ISSUED)
  issuedOn    DateTime
  expectedOn  DateTime?
  total       Int
  notes       String?
  createdById String
  createdBy   User                @relation("PurchaseOrderCreator", fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       PurchaseOrderLine[]
  bill        Expense?
  documents   Document[]

  @@index([status])
}

model PurchaseOrderLine {
  id          String          @id @default(cuid())
  orderId     String
  order       PurchaseOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitCost    Int
  receivedQty Int             @default(0)
  stockItemId String?
  stockItem   StockItem?      @relation(fields: [stockItemId], references: [id], onDelete: SetNull)
  movements   StockMovement[]
}

// ─── Inventory (consumables) ──────────────────────────────────────────────────

enum StockCategory {
  MEDIA
  BATTERIES
  LIGHTING_SUPPLIES
  GRIP_SUPPLIES
  CABLES
  CLEANING
  PROPS
  OFFICE
}

model StockItem {
  id           String                @id @default(cuid())
  sku          String                @unique
  name         String
  category     StockCategory
  unit         String
  onHand       Int                   @default(0)
  reorderLevel Int                   @default(0)
  location     StudioLocation
  unitCost     Int
  notes        String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  movements    StockMovement[]
  requestItems PurchaseRequestItem[]
  orderLines   PurchaseOrderLine[]
}

enum StockMovementType {
  RECEIVED
  ISSUED
  RETURNED
  ADJUSTED
}

model StockMovement {
  id                  String             @id @default(cuid())
  stockItemId         String
  stockItem           StockItem          @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type                StockMovementType
  /// Signed change in units (+ in, - out).
  quantity            Int
  balanceAfter        Int
  projectId           String?
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id], onDelete: SetNull)
  note                String?
  actorId             String?
  actor               User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  @@index([stockItemId, createdAt])
}

// ─── Studios ──────────────────────────────────────────────────────────────────

model Studio {
  id         String          @id @default(cuid())
  name       String          @unique
  location   StudioLocation
  kind       String
  capacity   Int?
  /// Whole rupees per hour (demo rate).
  hourlyRate Int
  features   String[]
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  bookings   StudioBooking[]
}

enum StudioBookingStatus {
  TENTATIVE
  CONFIRMED
  CANCELLED
}

model StudioBooking {
  id         String              @id @default(cuid())
  studioId   String
  studio     Studio              @relation(fields: [studioId], references: [id], onDelete: Cascade)
  title      String
  projectId  String?
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  shootId    String?
  shoot      Shoot?              @relation(fields: [shootId], references: [id], onDelete: SetNull)
  startsAt   DateTime
  endsAt     DateTime
  status     StudioBookingStatus @default(CONFIRMED)
  notes      String?
  bookedById String?
  bookedBy   User?               @relation(fields: [bookedById], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([studioId, startsAt])
}

// ─── Documents (ADR-0012) ─────────────────────────────────────────────────────

enum DocumentCategory {
  CONTRACT
  PROPOSAL
  BRIEF
  SCRIPT
  STORYBOARD
  INVOICE
  PURCHASE
  RECEIPT
  HR
  DELIVERY
  OTHER
}

model Document {
  id              String            @id @default(cuid())
  title           String
  category        DocumentCategory
  description     String?
  /// Requires `document:confidential` to read.
  confidential    Boolean           @default(false)
  currentVersion  Int               @default(0)
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId        String?
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId          String?
  lead            Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  vendorId        String?
  vendor          Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  teamMemberId    String?
  teamMember      TeamMember?       @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  invoiceId       String?
  invoice         Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  expenseId       String?
  expense         Expense?          @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User              @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  versions        DocumentVersion[]

  @@index([category])
  @@index([projectId])
  @@index([clientId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  /// Random key inside NOVA_STORAGE_DIR; never derived from user input.
  storageKey   String   @unique
  note         String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([documentId, version])
}
