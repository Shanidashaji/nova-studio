{
  "name": "@nova/db",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and typed client for NOVA",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma generate && tsx src/seed/index.ts",
    "reset": "prisma migrate reset --force && prisma generate && tsx src/seed/index.ts"
  },
  "dependencies": {
    "@nova/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@nova/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
