# Local development. Copy to `.env` (git-ignored) and fill in. For Vercel see .env.production.example.

# ─── Database (MongoDB Atlas) ────────────────────────────────────────────────
# Atlas → your cluster → Connect → Drivers. Transactions need a replica set: every Atlas tier
# (including the free M0) is one. Use a separate database name for tests: the test run wipes it.
# Create collections and indexes once per database with `pnpm db:setup` (the seed does it too).
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nova_dev?retryWrites=true&w=majority&appName=nova
TEST_DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nova_test?retryWrites=true&w=majority&appName=nova

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Origin(s) allowed to make state-changing requests. The Studio runs on :3100 (one Next.js app
# that also serves the API at /api). Comma-separated.
WEB_ORIGIN=http://localhost:3100
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=8

# Optional: send /api/* to a separately running API (`pnpm --filter @nova/api start`, port
# API_PORT) instead of the one built into the web app. Leave unset normally.
# API_INTERNAL_URL=http://localhost:4000
# API_PORT=4000

# ─── Seed ────────────────────────────────────────────────────────────────────
# The initial administrator. Required by `pnpm db:seed`; choose your own values.
# The password must be at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Studio Admin

# ─── NOVA AI (optional) ──────────────────────────────────────────────────────
# Without a key the assistant runs in demo mode (local intelligence over live data).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
# ASSISTANT_MODEL=claude-opus-5-5

# ─── Client communication (optional) ─────────────────────────────────────────
# Without these, client messages the studio approves are recorded as SIMULATED: nothing is sent.
# With both set, approved email messages go out through Resend (https://resend.com).
# WhatsApp has no integration and is always simulated.
# RESEND_API_KEY=
# MAIL_FROM=Studio <studio@your-domain.example>
# Name used for {{studio}} in message templates (default: Neon Minds).
# STUDIO_NAME=Neon Minds
# Base URL for {{reviewLink}} (the deliverable id is appended). Without it, review messages are
# held as drafts until someone pastes the link.
# REVIEW_LINK_BASE=https://review.your-domain.example/d
