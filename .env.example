# ─── Database ────────────────────────────────────────────────────────────────
# `pnpm db:start` runs an embedded PostgreSQL server using these credentials.
# Any other PostgreSQL 14+ server works too (Docker: `docker compose up -d`).
DATABASE_URL=postgresql://nova:nova@localhost:54329/nova
TEST_DATABASE_URL=postgresql://nova:nova@localhost:54329/nova_test
# Optional: where the embedded server keeps its data (default: %LOCALAPPDATA%\nova\pgdata
# on Windows, ~/.local/share/nova/pgdata elsewhere). Keep it outside synced folders.
# NOVA_PG_DATA_DIR=

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=4000
# Origin allowed to make state-changing requests (the Next.js app).
# Comma-separated; add another origin if you run the web app on a second port.
WEB_ORIGIN=http://localhost:3100
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=8

# ─── Web ─────────────────────────────────────────────────────────────────────
# Where Next.js forwards /api/* requests.
API_INTERNAL_URL=http://localhost:4000

# ─── Documents ───────────────────────────────────────────────────────────────
# Private file storage for uploaded documents (ADR-0012). Default: %LOCALAPPDATA%\nova\storage on
# Windows, ~/.local/share/nova/storage elsewhere. Keep it outside the repository and synced folders.
# NOVA_STORAGE_DIR=

# ─── Seed ────────────────────────────────────────────────────────────────────
# The initial administrator. Required by `pnpm db:seed`; choose your own values.
# The password must be at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Studio Admin

# ─── NOVA AI (optional) ──────────────────────────────────────────────────────
# Without a key the assistant runs in demo mode (local intelligence over live data).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
# ASSISTANT_MODEL=claude-opus-5-5
